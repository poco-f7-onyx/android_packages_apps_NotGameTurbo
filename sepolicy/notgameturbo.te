allow platform_app_all hal_touchfeature_xiaomi_service:service_manager find;
binder_call(platform_app_all, hal_touchfeature_xiaomi_default)
allow priv_app_all hal_touchfeature_xiaomi_service:service_manager find;
binder_call(priv_app_all, hal_touchfeature_xiaomi_default)

allow platform_app_all vendor_sysfs_touch:file rw_file_perms;
allow priv_app_all vendor_sysfs_touch:file rw_file_perms;

typeattribute vendor_sysfs_touch mlstrustedobject;
